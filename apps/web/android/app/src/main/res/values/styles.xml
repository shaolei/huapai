<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 窗口背景 = 牌桌绿。
             这是挖孔屏那一侧的颜色来源：父主题是 DayNight，深色模式下
             windowBackground 是 #121212 那种灰，填充到刘海区就与牌桌绿割裂。
             同色之后视觉上就是一整块牌桌。 -->
        <item name="android:windowBackground">@color/huapai_felt</item>
        <item name="android:colorBackground">@color/huapai_felt</item>
        <!-- 系统栏虽然被 MainActivity 隐掉了，但上滑临时调出时仍是这个颜色，
             避免闪一下灰条 -->
        <item name="android:statusBarColor">@color/huapai_felt</item>
        <item name="android:navigationBarColor">@color/huapai_felt</item>
        <!-- 横屏时刘海/挖孔在短边（左右两侧）：允许内容延伸到挖孔区，
             配合 MainActivity 的沉浸式全屏，避免两侧被白白切掉一条。
             （该属性为 API 28+，低版本系统会忽略。） -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>