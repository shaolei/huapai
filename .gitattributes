# Normalize all text to LF in the repository regardless of the developer's OS.
* text=auto eol=lf

# Windows batch/shell launchers need their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf

# Binary assets — never touched by EOL normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.jar binary

# Keep diffs readable for generated lockfiles.
pnpm-lock.yaml merge=union
